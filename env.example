# Copy to .env (gitignored) and fill in real values before running
# docker compose up. Never commit the filled-in .env.

# Path overrides - defaults assume this compose file lives at
# /opt/server-stack/compose/portfoliocms/ per the server's layout.
# Only set these if you're running from somewhere else (e.g. locally).
# PORTFOLIOCMS_REPO=../../websites/portfoliocms
# SERVER_STACK_DATA=../../data/portfoliocms

# SQL Server 'sa' password - must satisfy SQL Server's complexity rules
# (8+ chars, upper+lower+digit or symbol).
DB_SA_PASSWORD=

# JWT signing key - generate a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=24

# Public URL of the admin panel (used for CORS and password-reset links)
FRONTEND_URL=https://cms.example.com
# Public URL of the public-facing portfolio-site, if it also calls the API
PORTFOLIO_SITE_URL=

# URL the admin panel's browser bundle calls the API at (baked in at build time)
ADMIN_API_URL=https://cms-api.example.com/api

# Gmail SMTP (or other provider) for password-reset / contact-form emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=PortfolioCMS
SMTP_PASSWORD=

# Cloudflare Turnstile (contact form bot protection). The site key is public
# and lives in the portfolio-site's own env (not here) - this is only the
# secret key, from the same Turnstile widget in the Cloudflare dashboard.
# Never commit this.
TURNSTILE_SECRET_KEY=
