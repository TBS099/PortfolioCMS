# Base URL of your PortfolioCMS ASP.NET API, including the /api segment
# (cms.js appends paths like /Hero, /Project, /FileUpload/public to this).
# Leave unset to run against mock data (see src/lib/api/mockData.js).
#
# This is read by src/lib/config.js, which also has a directly-editable
# fallback constant if you'd rather not manage a .env file at all.
#
# Local dev example (adjust the port to whatever `dotnet run` prints):
# VITE_CMS_API_URL=https://localhost:7001/api
#
# Production example:
# VITE_CMS_API_URL=https://api.yourdomain.com/api

# Not currently used — every endpoint the frontend calls is public
# (unauthenticated) in your controllers. Kept for a future authenticated read.
# VITE_CMS_API_KEY=

# Cloudflare Turnstile site key for the contact form. This is the *public*
# key (safe to ship to the browser) — read by src/lib/config.js, which also
# has a directly-editable fallback constant already set to your real site
# key, so this is optional unless you want to override it per environment.
# The matching *secret* key goes in the PortfolioCMS backend's own .env
# (TURNSTILE_SECRET_KEY), never here.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFIBDbxes9RjnEhd
